# Development uses HTTP; production must set APP_ENV=production and enable
# secure cookies in the hosting provider's environment settings.
APP_ENV=development
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
# URL of the browser-facing Next.js app. Flask redirects legacy page URLs here.
FRONTEND_URL=http://localhost:3000

# Flask session signing key. Generate a long random value for every deployment.
FLASK_SECRET_KEY=df8ede8fe0c3ba9ee916745d684d735479d121b080264e383684c968544744f6

# Flask talks to Supabase through its HTTPS Data API, not a Postgres connection.
SUPABASE_URL=https://uamcxjuunivhfvkjurka.supabase.co
# Copy the private sb_secret_ key from Supabase Dashboard > Settings > API.
# Never put this value in browser code or commit it.
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_private_key
# Alternatively, deployments still using the legacy key name can set:
# SUPABASE_SERVICE_ROLE_KEY=<legacy service-role key>
# This publishable key is safe for future browser use but is not used by Flask.
VITE_SUPABASE_URL=https://uamcxjuunivhfvkjurka.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_gWpJnDxWp-UUIbjrnMMeEA_a7zbrmyg
