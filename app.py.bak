@app.get("/api/returnable-borrowings")
def returnable_borrowings():
    if not logged_in(): return jsonify(error="Please log in first."), 401
    denied = admin_required(api=True)
    if denied:
        return denied
    search, status = request.args.get("search", "").strip(), request.args.get("status", "").strip()
    start_date, end_date = request.args.get("start_date", "").strip(), request.args.get("end_date", "").strip()
    date_field, sort = request.args.get("date_field", "borrowed"), request.args.get("sort", "newest")
    db = cursor = None
    try:
        db=connection(); cursor=db.cursor(dictionary=True)
        sql="SELECT DISTINCT b.borrowing_id,b.borrowed_at,b.expected_return_date,b.status,br.full_name FROM borrowings b JOIN borrowers br ON br.borrower_id=b.borrower_id WHERE 1=1"
        values=[]
        if search: sql+=" AND (br.full_name LIKE %s OR CAST(b.borrowing_id AS CHAR) LIKE %s OR EXISTS (SELECT 1 FROM borrowing_items si JOIN equipment se ON se.equipment_id=si.equipment_id WHERE si.borrowing_id=b.borrowing_id AND se.equipment_name LIKE %s))"; values += [f"%{search}%"]*3
        if status: sql+=" AND b.status=%s"; values.append(status)
        if date_field == 'expected': column='DATE(b.expected_return_date)'
        elif date_field == 'actual': column='(SELECT MAX(rr.return_date) FROM return_records rr JOIN borrowing_items ri ON ri.borrowing_item_id=rr.borrowing_item_id WHERE ri.borrowing_id=b.borrowing_id)'
        else: column='DATE(b.borrowed_at)'
        if start_date: sql+=f" AND {column} >= %s";values.append(start_date)
        if end_date: sql+=f" AND {column} <= %s";values.append(end_date)
        order={"newest":"b.borrowed_at DESC","oldest":"b.borrowed_at","borrower":"br.full_name","status":"b.status, b.borrowed_at DESC","expected":"b.expected_return_date"}.get(sort,"b.borrowed_at DESC")
        cursor.execute(sql+" ORDER BY "+order,values); return jsonify(cursor.fetchall())
    except mysql.connector.Error: return jsonify(error="Unable to load borrowing transactions."),500
    finally:
        if cursor: cursor.close()
        if db and db.is_connected(): db.close()


@app.get("/api/borrowings/<int:borrowing_id>/items")
def return_items(borrowing_id):
    if not logged_in(): return jsonify(error="Please log in first."),401
    denied = admin_required(api=True)
    if denied:
        return denied
    db=cursor=None
    try:
        db=connection();cursor=db.cursor(dictionary=True)
        cursor.execute("SELECT b.borrowing_id,b.borrowed_at,b.expected_return_date,b.status,br.full_name,br.contact_number,br.address FROM borrowings b JOIN borrowers br ON br.borrower_id=b.borrower_id WHERE b.borrowing_id=%s",(borrowing_id,)); loan=cursor.fetchone()
        if not loan: return jsonify(error="Borrowing transaction not found."),404
        cursor.execute("SELECT bi.borrowing_item_id,e.equipment_name,e.unit_type,bi.quantity_borrowed,bi.quantity_returned,bi.remaining_quantity FROM borrowing_items bi JOIN equipment e ON e.equipment_id=bi.equipment_id WHERE bi.borrowing_id=%s ORDER BY e.equipment_name",(borrowing_id,)); loan['items']=cursor.fetchall();return jsonify(loan)
    except mysql.connector.Error: return jsonify(error="Unable to load loan items."),500
    finally:
        if cursor:cursor.close()
        if db and db.is_connected():db.close()


@app.post("/returns/save")
def return_save():
    if not logged_in(): return message("login_page","Please log in first.")
    denied = admin_required()
    if denied:
        return denied
    try:
        borrowing_id=int(request.form.get('borrowing_id',''))
        return_date=date.fromisoformat(request.form.get('return_date',''))
        raw_items=json.loads(request.form.get('items','[]'))
        if len(request.form.get('notes','').strip()) > 2000: raise ValueError("Return notes cannot exceed 2,000 characters.")
        if borrowing_id<=0 or not raw_items: raise ValueError("Select a transaction and enter at least one returned quantity.")
        if return_date>date.today(): raise ValueError("Return date cannot be in the future.")
        items=[];seen=set()
        for item in raw_items:
            item_id,quantity=int(item['borrowing_item_id']),int(item['quantity'])
            if item_id<=0 or quantity<=0: raise ValueError("Returned quantities must be greater than zero.")
            if item_id in seen: raise ValueError("Duplicate return items are not allowed.")
            seen.add(item_id);items.append((item_id,quantity))
    except (ValueError,TypeError,KeyError,json.JSONDecodeError) as error:
        return message("returns_page", str(error) if isinstance(error,ValueError) else "Return information is invalid.")
    db=cursor=None
    try:
        db=connection();db.start_transaction();cursor=db.cursor(dictionary=True)
        cursor.execute("SELECT borrowing_id FROM borrowings WHERE borrowing_id=%s AND status IN ('Active','Partially Returned') FOR UPDATE",(borrowing_id,))
        if not cursor.fetchone(): raise ValueError("This borrowing transaction is not active or was not found.")
        for item_id,quantity in sorted(items):
            cursor.execute("SELECT bi.borrowing_item_id,bi.equipment_id,bi.remaining_quantity,e.equipment_name,e.total_stock,e.available_stock FROM borrowing_items bi JOIN equipment e ON e.equipment_id=bi.equipment_id WHERE bi.borrowing_item_id=%s AND bi.borrowing_id=%s FOR UPDATE",(item_id,borrowing_id));item=cursor.fetchone()
            if not item: raise ValueError("One return item does not belong to this transaction.")
            if quantity>item['remaining_quantity']: raise ValueError(f"Returned quantity for {item['equipment_name']} cannot exceed its remaining quantity of {item['remaining_quantity']}.")
            if item['available_stock']+quantity>item['total_stock']: raise RuntimeError(f"Stock integrity check failed for {item['equipment_name']}.")
        for item_id,quantity in items:
            cursor.execute("SELECT equipment_id FROM borrowing_items WHERE borrowing_item_id=%s",(item_id,));equipment_id=cursor.fetchone()['equipment_id']
            cursor.execute("UPDATE borrowing_items SET quantity_returned=quantity_returned+%s WHERE borrowing_item_id=%s",(quantity,item_id))
            cursor.execute("UPDATE equipment SET available_stock=available_stock+%s WHERE equipment_id=%s",(quantity,equipment_id))
            cursor.execute("INSERT INTO return_records (borrowing_item_id,received_by,quantity_returned,return_date,notes) VALUES (%s,%s,%s,%s,%s)",(item_id,session['user_id'],quantity,return_date,request.form.get('notes','').strip() or None))
        cursor.execute("SELECT COALESCE(SUM(remaining_quantity),0) AS remaining FROM borrowing_items WHERE borrowing_id=%s",(borrowing_id,));remaining=cursor.fetchone()['remaining'];status='Returned' if remaining==0 else 'Partially Returned'
        cursor.execute("UPDATE borrowings SET status=%s WHERE borrowing_id=%s",(status,borrowing_id))
        cursor.execute("INSERT INTO audit_logs (user_id,action,table_name,record_id,description) VALUES (%s,%s,%s,%s,%s)",(session['user_id'],'RETURN','borrowings',borrowing_id,f"Recorded return for transaction #{borrowing_id}; status: {status}"))
        db.commit();return message("returns_page",f"Return saved successfully. Transaction status: {status}.")
    except (mysql.connector.Error,ValueError,RuntimeError) as error:
        if db:db.rollback()
        return message("returns_page",str(error) if isinstance(error,(ValueError,RuntimeError)) else "Unable to save return. No stock was changed.")
    finally:
        if cursor:cursor.close()
        if db and db.is_connected():db.close()


