@app.get("/staff/requests")
def staff_requests_page():
    denied = staff_required()
    if denied:
        return denied
    return render_template("staff_requests.html", full_name=session["full_name"])


@app.get("/api/staff/requests")
def staff_request_list():
    """Return only requests owned by the authenticated Staff account."""
    denied = staff_required(api=True)
    if denied:
        return denied
    db = cursor = None
    try:
        db = connection()
        cursor = db.cursor(dictionary=True)
        cursor.execute(
            "SELECT b.borrowing_id, e.equipment_name, bi.quantity_borrowed, "
            "b.purpose_notes, b.date_needed, b.expected_return_date, "
            "b.additional_notes, b.created_at AS request_date, b.status, b.processed_by "
            "FROM borrowers br "
            "JOIN borrowings b ON b.borrower_id = br.borrower_id "
            "JOIN borrowing_items bi ON bi.borrowing_id = b.borrowing_id "
            "JOIN equipment e ON e.equipment_id = bi.equipment_id "
            "WHERE br.user_id = %s "
            "ORDER BY b.created_at DESC, b.borrowing_id DESC, e.equipment_name",
            (session["user_id"],),
        )
        rows = cursor.fetchall()
        for row in rows:
            if hasattr(row.get("date_needed"), "isoformat"):
                row["date_needed"] = row["date_needed"].isoformat()
            if hasattr(row.get("expected_return_date"), "isoformat"):
                row["expected_return_date"] = row["expected_return_date"].isoformat()
            if hasattr(row.get("request_date"), "isoformat"):
                row["request_date"] = row["request_date"].isoformat()
        return jsonify(rows)
    except mysql.connector.Error:
        return jsonify(error="Unable to load your borrowing requests."), 500
    finally:
        if cursor:
            cursor.close()
        if db and db.is_connected():
            db.close()


@app.post("/staff/requests/create")
def staff_request_create():
    denied = staff_required()
    if denied:
        return denied
    try:
        equipment_id, quantity = int(request.form.get("equipment_id", "")), int(request.form.get("quantity", ""))
        date_needed, expected_return = date.fromisoformat(request.form.get("date_needed", "")), date.fromisoformat(request.form.get("expected_return_date", ""))
        purpose, notes = request.form.get("purpose_notes", "").strip(), request.form.get("additional_notes", "").strip()
        if equipment_id <= 0 or quantity <= 0 or not purpose:
            raise ValueError("Equipment, a positive quantity, purpose, and both dates are required.")
        if expected_return < date_needed:
            raise ValueError("Expected return date cannot be earlier than the date needed.")
        if len(purpose) > 2000 or len(notes) > 2000:
            raise ValueError("Purpose and additional notes cannot exceed 2,000 characters.")
    except (TypeError, ValueError) as error:
        return message("staff_equipment_page", str(error) if isinstance(error, ValueError) else "Request information is invalid.")
    db = cursor = None
    try:
        db = connection(); db.start_transaction(); cursor = db.cursor(dictionary=True)
        cursor.execute("SELECT borrower_id FROM borrowers WHERE user_id = %s FOR UPDATE", (session["user_id"],))
        borrower = cursor.fetchone()
        if not borrower:
            cursor.execute("SELECT full_name, contact_number, address, email FROM users WHERE user_id = %s FOR UPDATE", (session["user_id"],))
            user = cursor.fetchone()
            if not user:
                raise ValueError("User account not found.")
            # Check if there is an unlinked borrower record (matching email or full name)
            cursor.execute(
                "SELECT borrower_id FROM borrowers WHERE user_id IS NULL AND (email = %s OR full_name = %s) LIMIT 1 FOR UPDATE",
                (user.get("email"), user.get("full_name")),
            )
            unlinked = cursor.fetchone()
            if unlinked:
                cursor.execute("UPDATE borrowers SET user_id = %s WHERE borrower_id = %s", (session["user_id"], unlinked["borrower_id"]))
                borrower_id = unlinked["borrower_id"]
            else:
                cursor.execute(
                    "INSERT INTO borrowers (user_id, full_name, contact_number, address, email) VALUES (%s, %s, %s, %s, %s)",
                    (session["user_id"], user["full_name"], user.get("contact_number") or None, user.get("address") or None, user.get("email") or None),
                )
                borrower_id = cursor.lastrowid
        else:
            borrower_id = borrower["borrower_id"]
        cursor.execute("SELECT equipment_name, available_stock FROM equipment WHERE equipment_id = %s FOR UPDATE", (equipment_id,))
        equipment = cursor.fetchone()
        if not equipment:
            raise ValueError("The selected equipment no longer exists.")
        if quantity > equipment["available_stock"]:
            raise ValueError(f"Only {equipment['available_stock']} item(s) of {equipment['equipment_name']} are available.")
        cursor.execute("INSERT INTO borrowings (borrower_id, date_needed, expected_return_date, purpose_notes, additional_notes, status) VALUES (%s, %s, %s, %s, %s, 'Pending')", (borrower_id, date_needed, expected_return, purpose, notes or None))
        borrowing_id = cursor.lastrowid
        cursor.execute("INSERT INTO borrowing_items (borrowing_id, equipment_id, quantity_borrowed, quantity_returned) VALUES (%s, %s, %s, 0)", (borrowing_id, equipment_id, quantity))
        cursor.execute("INSERT INTO audit_logs (user_id, action, table_name, record_id, description) VALUES (%s, %s, %s, %s, %s)", (session["user_id"], "CREATE", "borrowings", borrowing_id, f"Submitted borrowing request #{borrowing_id}"))
        db.commit()
        return message("staff_requests_page", "Borrowing request submitted successfully. It is pending Admin review.")
    except (mysql.connector.Error, ValueError) as error:
        if db: db.rollback()
        return message("staff_equipment_page", str(error) if isinstance(error, ValueError) else "Unable to submit your borrowing request. No request was saved.")
    finally:
        if cursor: cursor.close()
        if db and db.is_connected(): db.close()


@app.get("/admin/borrowing-requests")
def admin_request_review_page():
    if not logged_in(): return message("login_page", "Please log in first.")
    denied = admin_required()
    if denied: return denied
    return render_template("admin_borrowing_requests.html", full_name=session["full_name"])


@app.get("/api/admin/borrowing-requests")
def admin_request_review_list():
    if not logged_in(): return jsonify(error="Please log in first."), 401
    denied = admin_required(api=True)
    if denied: return denied
    db = cursor = None
    try:
        db=connection(); cursor=db.cursor(dictionary=True)
        cursor.execute("SELECT b.borrowing_id, u.full_name AS borrower_name, e.equipment_name, bi.quantity_borrowed, b.purpose_notes, b.date_needed, b.expected_return_date, b.additional_notes, b.created_at AS request_date, b.status, b.processed_by FROM borrowings b JOIN borrowers br ON br.borrower_id=b.borrower_id JOIN users u ON u.user_id=br.user_id JOIN borrowing_items bi ON bi.borrowing_id=b.borrowing_id JOIN equipment e ON e.equipment_id=bi.equipment_id ORDER BY (b.status='Pending') DESC,b.created_at DESC")
        rows = cursor.fetchall()
        for row in rows:
            if hasattr(row.get("date_needed"), "isoformat"):
                row["date_needed"] = row["date_needed"].isoformat()
            if hasattr(row.get("expected_return_date"), "isoformat"):
                row["expected_return_date"] = row["expected_return_date"].isoformat()
            if hasattr(row.get("request_date"), "isoformat"):
                row["request_date"] = row["request_date"].isoformat()
        return jsonify(rows)
    except mysql.connector.Error: return jsonify(error="Unable to load borrowing requests."), 500
    finally:
        if cursor: cursor.close()
        if db and db.is_connected(): db.close()


@app.post("/admin/borrowing-requests/<int:borrowing_id>/<action>")
def admin_request_review_action(borrowing_id, action):
    if not logged_in(): return message("login_page", "Please log in first.")
    denied = admin_required()
    if denied: return denied
    if action not in ("approve", "reject", "cancel"): return message("admin_request_review_page", "Invalid request action.")
    db = cursor = None
    try:
        db=connection(); db.start_transaction(); cursor=db.cursor(dictionary=True)
        cursor.execute("SELECT status, processed_by FROM borrowings WHERE borrowing_id=%s FOR UPDATE", (borrowing_id,)); record=cursor.fetchone()
        if not record: raise ValueError("Borrowing request was not found.")
        if record["status"] != "Pending": raise ValueError("Only Pending requests can be reviewed.")
        if action == "approve":
            cursor.execute("UPDATE borrowings SET status='Approved', processed_by=%s WHERE borrowing_id=%s", (session["user_id"], borrowing_id))
            description = f"Approved borrowing request #{borrowing_id} for release"
            msg = "Request approved for release; stock was not changed."
        elif action == "reject":
            cursor.execute("UPDATE borrowings SET status='Rejected', processed_by=%s WHERE borrowing_id=%s", (session["user_id"], borrowing_id))
            description = f"Rejected borrowing request #{borrowing_id}"
            msg = "Borrowing request rejected."
        else:
            cursor.execute("UPDATE borrowings SET status='Cancelled', processed_by=%s WHERE borrowing_id=%s", (session["user_id"], borrowing_id))
            description = f"Cancelled borrowing request #{borrowing_id}"
            msg = "Borrowing request cancelled."
        cursor.execute("INSERT INTO audit_logs (user_id, action, table_name, record_id, description) VALUES (%s, %s, %s, %s, %s)", (session["user_id"], "UPDATE", "borrowings", borrowing_id, description))
        db.commit()
        return message("admin_request_review_page", msg)
    except (mysql.connector.Error, ValueError) as error:
        if db: db.rollback()
        return message("admin_request_review_page", str(error) if isinstance(error, ValueError) else "Unable to update the borrowing request.")
    finally:
        if cursor: cursor.close()
        if db and db.is_connected(): db.close()


@app.post("/borrowers/<int:borrower_id>/approve-pending-request")
def borrower_approve_pending_request(borrower_id):
    """Approve and release the borrower's oldest pending request in one transaction."""
    if not logged_in():
        return message("login_page", "Please log in first.")
    denied = admin_required()
    if denied:
        return denied
    db = cursor = None
    try:
        db = connection(); db.start_transaction(); cursor = db.cursor(dictionary=True)
        cursor.execute(
            "SELECT borrowing_id FROM borrowings WHERE borrower_id=%s AND status='Pending' "
            "ORDER BY created_at, borrowing_id LIMIT 1 FOR UPDATE",
            (borrower_id,),
        )
        pending_request = cursor.fetchone()
        if not pending_request:
            raise ValueError("This borrower has no pending borrowing request to approve.")
        borrowing_id = pending_request["borrowing_id"]
        cursor.execute(
            "SELECT borrowing_item_id, equipment_id, quantity_borrowed FROM borrowing_items "
            "WHERE borrowing_id=%s ORDER BY equipment_id FOR UPDATE",
            (borrowing_id,),
        )
        items = cursor.fetchall()
        if not items:
            raise ValueError("This request has no equipment items.")
        equipment_rows = []
        for item in items:
            cursor.execute(
                "SELECT equipment_name, available_stock FROM equipment WHERE equipment_id=%s FOR UPDATE",
                (item["equipment_id"],),
            )
            equipment = cursor.fetchone()
            if not equipment:
                raise ValueError("One requested equipment record no longer exists.")
            if item["quantity_borrowed"] <= 0 or item["quantity_borrowed"] > equipment["available_stock"]:
                raise ValueError(f"Insufficient stock for {equipment['equipment_name']}. Available: {equipment['available_stock']}.")
            equipment_rows.append((item, equipment))
        for item, _ in equipment_rows:
            cursor.execute(
                "UPDATE equipment SET available_stock=available_stock-%s "
                "WHERE equipment_id=%s AND available_stock >= %s",
                (item["quantity_borrowed"], item["equipment_id"], item["quantity_borrowed"]),
            )
            if cursor.rowcount != 1:
                raise RuntimeError("Stock changed while approving the request. Please try again.")
        cursor.execute(
            "UPDATE borrowings SET status='Active', processed_by=%s, borrowed_at=NOW() WHERE borrowing_id=%s",
            (session["user_id"], borrowing_id),
        )
        cursor.execute(
            "INSERT INTO audit_logs (user_id, action, table_name, record_id, description) "
            "VALUES (%s, %s, %s, %s, %s)",
            (session["user_id"], "UPDATE", "borrowings", borrowing_id,
             f"Approved and released borrowing request #{borrowing_id}"),
        )
        db.commit()
        return message("borrowers_page", "Borrowing request approved and equipment released successfully.")
    except (mysql.connector.Error, ValueError, RuntimeError) as error:
        if db:
            db.rollback()
        return message("borrowers_page", str(error) if isinstance(error, (ValueError, RuntimeError)) else "Unable to approve the borrowing request. No stock was changed.")
    finally:
        if cursor:
            cursor.close()
        if db and db.is_connected():
            db.close()


@app.post("/admin/borrowing-requests/<int:borrowing_id>/release")
def admin_request_release(borrowing_id):
    """Release a prepared request exactly once and decrease stock atomically."""
    if not logged_in(): return message("login_page", "Please log in first.")
    denied = admin_required()
    if denied: return denied
    db = cursor = None
    try:
        db = connection(); db.start_transaction(); cursor = db.cursor(dictionary=True)
        cursor.execute("SELECT borrowing_id, borrower_id, status, processed_by FROM borrowings WHERE borrowing_id=%s FOR UPDATE", (borrowing_id,))
        request_record = cursor.fetchone()
        if not request_record: raise ValueError("Borrowing request was not found.")
        if request_record["status"] != "Approved": raise ValueError("Only Approved requests can be released.")
        cursor.execute("SELECT borrower_id FROM borrowers WHERE borrower_id=%s FOR UPDATE", (request_record["borrower_id"],))
        if not cursor.fetchone(): raise ValueError("The borrower record is no longer valid.")
        cursor.execute("SELECT borrowing_item_id, equipment_id, quantity_borrowed FROM borrowing_items WHERE borrowing_id=%s ORDER BY equipment_id FOR UPDATE", (borrowing_id,))
        items = cursor.fetchall()
        if not items: raise ValueError("This request has no equipment items.")
        equipment_rows = []
        for item in items:
            if item["quantity_borrowed"] <= 0: raise ValueError("Requested quantity must be greater than zero.")
            cursor.execute("SELECT equipment_name, total_stock, available_stock FROM equipment WHERE equipment_id=%s FOR UPDATE", (item["equipment_id"],))
            equipment = cursor.fetchone()
            if not equipment: raise ValueError("One requested equipment record no longer exists.")
            if item["quantity_borrowed"] > equipment["available_stock"]: raise ValueError(f"Insufficient stock for {equipment['equipment_name']}. Available: {equipment['available_stock']}.")
            equipment_rows.append((item, equipment))
        for item, equipment in equipment_rows:
            cursor.execute("UPDATE equipment SET available_stock=available_stock-%s WHERE equipment_id=%s AND available_stock >= %s", (item["quantity_borrowed"], item["equipment_id"], item["quantity_borrowed"]))
            if cursor.rowcount != 1: raise RuntimeError("Stock changed while releasing equipment. Please try again.")
        cursor.execute("UPDATE borrowings SET status='Active', processed_by=%s, borrowed_at=NOW() WHERE borrowing_id=%s", (session["user_id"], borrowing_id))
        cursor.execute("INSERT INTO audit_logs (user_id, action, table_name, record_id, description) VALUES (%s,%s,%s,%s,%s)", (session["user_id"], "UPDATE", "borrowings", borrowing_id, f"Released equipment for borrowing request #{borrowing_id}"))
        db.commit()
        return message("admin_request_review_page", "Equipment released successfully. Stock and request status were updated.")
    except (mysql.connector.Error, ValueError, RuntimeError) as error:
        if db: db.rollback()
        return message("admin_request_review_page", str(error) if isinstance(error, (ValueError, RuntimeError)) else "Unable to release equipment. No stock was changed.")
    finally:
        if cursor: cursor.close()
        if db and db.is_connected(): db.close()


