@app.get('/api/reports')
def reports_data():
    if not logged_in(): return jsonify(error='Please log in first.'),401
    denied = admin_required(api=True)
    if denied: return denied
    report=request.args.get('type','inventory'); search=request.args.get('search','').strip(); status=request.args.get('status','').strip(); start=request.args.get('start_date','').strip(); end=request.args.get('end_date','').strip(); borrower=request.args.get('borrower_id','').strip()
    db=cursor=None
    try:
        db=connection();cursor=db.cursor(dictionary=True);values=[]
        if report in ('inventory','available'):
            sql="SELECT equipment_id AS 'Equipment ID',equipment_name AS 'Equipment Name',category AS Category,total_stock AS 'Total Quantity',available_stock AS 'Available Quantity',(total_stock-available_stock) AS 'Borrowed Quantity',unit_type AS Unit,CASE WHEN available_stock=0 THEN 'Out of Stock' WHEN available_stock<total_stock THEN 'Low Stock' ELSE 'Available' END AS Status FROM equipment WHERE 1=1"
            if report=='available':sql+=' AND available_stock>0'
            if search:sql+=' AND (equipment_name LIKE %s OR category LIKE %s OR unit_type LIKE %s)';values += [f'%{search}%']*3
            if status:sql+=" AND (CASE WHEN available_stock=0 THEN 'Out of Stock' WHEN available_stock<total_stock THEN 'Low Stock' ELSE 'Available' END)=%s";values.append(status)
            sql+=' ORDER BY equipment_name'
        elif report in ('active','returned','transaction','history'):
            sql="SELECT b.borrowing_id AS 'Loan ID',br.full_name AS Borrower,e.equipment_name AS Equipment,bi.quantity_borrowed AS Quantity,bi.quantity_returned AS 'Quantity Returned',bi.remaining_quantity AS Remaining,DATE(b.borrowed_at) AS 'Borrow Date',b.expected_return_date AS 'Expected Return Date',b.status AS Status,(SELECT MAX(rr.return_date) FROM return_records rr WHERE rr.borrowing_item_id=bi.borrowing_item_id) AS 'Return Date' FROM borrowings b JOIN borrowers br ON br.borrower_id=b.borrower_id JOIN borrowing_items bi ON bi.borrowing_id=b.borrowing_id JOIN equipment e ON e.equipment_id=bi.equipment_id WHERE 1=1"
            if report=='active':sql+=" AND b.status IN ('Active','Partially Returned')"
            if report=='returned':sql+=" AND b.status='Returned'"
            if report=='history' and borrower:sql+=' AND b.borrower_id=%s';values.append(borrower)
            if search:sql+=' AND (br.full_name LIKE %s OR e.equipment_name LIKE %s OR CAST(b.borrowing_id AS CHAR) LIKE %s)';values += [f'%{search}%']*3
            if status:sql+=' AND b.status=%s';values.append(status)
            if start:sql+=' AND DATE(b.borrowed_at)>=%s';values.append(start)
            if end:sql+=' AND DATE(b.borrowed_at)<=%s';values.append(end)
            sql+=' ORDER BY b.borrowed_at DESC,b.borrowing_id,e.equipment_name'
        else:return jsonify(error='Unknown report type.'),400
        cursor.execute(sql,values);return jsonify(cursor.fetchall())
    except mysql.connector.Error:return jsonify(error='Unable to generate report.'),500
    finally:
        if cursor:cursor.close()
        if db and db.is_connected():db.close()


