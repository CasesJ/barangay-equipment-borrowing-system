@app.get("/api/equipment")
def equipment_list():
    if not logged_in():
        return jsonify(error="Please log in first."), 401
    denied = admin_required(api=True)
    if denied: return denied
    search = request.args.get("search", "").strip()
    status_filter = request.args.get("status", "").strip()
    sort = request.args.get("sort", "name").strip()
    db = cursor = None
    try:
        db = connection()
        cursor = db.cursor(dictionary=True)
        where, values = [], []
        if search:
            where.append("(equipment_name LIKE %s OR category LIKE %s OR unit_type LIKE %s)")
            values.extend([f"%{search}%"] * 3)
        status_sql = "CASE WHEN available_stock = 0 THEN 'Out of Stock' WHEN available_stock < total_stock THEN 'Low Stock' ELSE 'Available' END"
        if status_filter == "Available": where.append("available_stock = total_stock")
        elif status_filter == "Out of Stock": where.append("available_stock = 0")
        elif status_filter == "Low Stock": where.append("available_stock > 0 AND available_stock < total_stock")
        sql = f"SELECT equipment_id, equipment_name, category, total_stock, available_stock, unit_type, created_at, updated_at, {status_sql} AS status FROM equipment"
        if where:
            sql += " WHERE " + " AND ".join(where)
        order_by = {"name": "equipment_name", "newest": "created_at DESC", "oldest": "created_at", "status": "equipment_name, status"}.get(sort, "equipment_name")
        sql += " ORDER BY " + order_by
        cursor.execute(sql, values)
        records = []
        for row in cursor.fetchall():
            row["borrowed_stock"] = row["total_stock"] - row["available_stock"]
            records.append(row)
        return jsonify(records)
    except mysql.connector.Error:
        return jsonify(error="Unable to load equipment. Check the MySQL connection."), 500
    finally:
        if cursor:
            cursor.close()
        if db and db.is_connected():
            db.close()


@app.post("/equipment/add")
def equipment_add():
    if not logged_in():
        return message("login_page", "Please log in first.")
    denied = admin_required()
    if denied: return denied
    try:
        name, category, total_stock, unit_type = equipment_values(request.form)
    except ValueError as error:
        return message("equipment_page", str(error))
    db = cursor = None
    try:
        db = connection()
        cursor = db.cursor(dictionary=True)
        cursor.execute("SELECT equipment_id FROM equipment WHERE LOWER(equipment_name) = LOWER(%s)", (name,))
        if cursor.fetchone():
            return message("equipment_page", "An equipment record with that name already exists.")
        cursor.execute("INSERT INTO equipment (equipment_name, category, total_stock, available_stock, unit_type) VALUES (%s, %s, %s, %s, %s)", (name, category, total_stock, total_stock, unit_type))
        equipment_id = cursor.lastrowid
        cursor.execute("INSERT INTO audit_logs (user_id, action, table_name, record_id, description) VALUES (%s, %s, %s, %s, %s)", (session["user_id"], "CREATE", "equipment", equipment_id, f"Added equipment: {name}"))
        db.commit()
        return message("equipment_page", "Equipment added successfully.")
    except mysql.connector.Error:
        if db: db.rollback()
        return message("equipment_page", "Unable to add equipment. Please try again.")
    finally:
        if cursor: cursor.close()
        if db and db.is_connected(): db.close()


@app.post("/equipment/<int:equipment_id>/edit")
def equipment_edit(equipment_id):
    if not logged_in():
        return message("login_page", "Please log in first.")
    denied = admin_required()
    if denied: return denied
    try:
        name, category, total_stock, unit_type = equipment_values(request.form)
    except ValueError as error:
        return message("equipment_page", str(error))
    db = cursor = None
    try:
        db = connection()
        cursor = db.cursor(dictionary=True)
        cursor.execute("SELECT total_stock, available_stock FROM equipment WHERE equipment_id = %s FOR UPDATE", (equipment_id,))
        current = cursor.fetchone()
        if not current:
            return message("equipment_page", "Equipment record was not found.")
        borrowed_stock = current["total_stock"] - current["available_stock"]
        if total_stock < borrowed_stock:
            return message("equipment_page", f"Total quantity cannot be lower than the {borrowed_stock} item(s) currently borrowed.")
        cursor.execute("SELECT equipment_id FROM equipment WHERE LOWER(equipment_name) = LOWER(%s) AND equipment_id <> %s", (name, equipment_id))
        if cursor.fetchone():
            return message("equipment_page", "An equipment record with that name already exists.")
        available_stock = total_stock - borrowed_stock
        cursor.execute("UPDATE equipment SET equipment_name = %s, category = %s, total_stock = %s, available_stock = %s, unit_type = %s WHERE equipment_id = %s", (name, category, total_stock, available_stock, unit_type, equipment_id))
        cursor.execute("INSERT INTO audit_logs (user_id, action, table_name, record_id, description) VALUES (%s, %s, %s, %s, %s)", (session["user_id"], "UPDATE", "equipment", equipment_id, f"Updated equipment: {name}"))
        db.commit()
        return message("equipment_page", "Equipment updated successfully.")
    except mysql.connector.Error:
        if db: db.rollback()
        return message("equipment_page", "Unable to update equipment. Please try again.")
    finally:
        if cursor: cursor.close()
        if db and db.is_connected(): db.close()


@app.post("/equipment/<int:equipment_id>/delete")
def equipment_delete(equipment_id):
    if not logged_in():
        return message("login_page", "Please log in first.")
    denied = admin_required()
    if denied:
        return denied
    db = cursor = None
    try:
        db = connection()
        cursor = db.cursor(dictionary=True)
        cursor.execute("SELECT equipment_name FROM equipment WHERE equipment_id = %s FOR UPDATE", (equipment_id,))
        current = cursor.fetchone()
        if not current:
            return message("equipment_page", "Equipment record was not found.")
        if has_active_equipment_loan(cursor, equipment_id):
            db.rollback()
            return message("equipment_page", "This equipment cannot be deleted because it is part of an active borrowing transaction.")
        cursor.execute("DELETE FROM equipment WHERE equipment_id = %s", (equipment_id,))
        cursor.execute("INSERT INTO audit_logs (user_id, action, table_name, record_id, description) VALUES (%s, %s, %s, %s, %s)", (session["user_id"], "DELETE", "equipment", equipment_id, f"Deleted equipment: {current['equipment_name']}"))
        db.commit()
        return message("equipment_page", "Equipment deleted successfully.")
    except mysql.connector.Error:
        if db: db.rollback()
        return message("equipment_page", "Unable to delete equipment. Please try again.")
    finally:
        if cursor: cursor.close()
        if db and db.is_connected(): db.close()


