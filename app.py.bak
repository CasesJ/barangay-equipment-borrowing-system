"""Flask authentication server for the existing XAMPP MySQL database."""
import os
import re
import json
from datetime import date, datetime
from pathlib import Path

import mysql.connector
from flask import Flask, jsonify, redirect, render_template, request, send_from_directory, session, url_for
from flask.json.provider import DefaultJSONProvider
from werkzeug.exceptions import HTTPException
from werkzeug.security import check_password_hash, generate_password_hash

ROOT = Path(__file__).resolve().parent
app = Flask(__name__)


class CustomJSONProvider(DefaultJSONProvider):
    def default(self, o):
        if isinstance(o, (date, datetime)):
            return o.isoformat()
        return super().default(o)


app.json = CustomJSONProvider(app)
app.config.update(
    SECRET_KEY=os.environ.get("FLASK_SECRET_KEY", "change-this-to-a-random-secret-before-deploying"),
    MYSQL_HOST=os.environ.get("MYSQL_HOST", "127.0.0.1"),
    MYSQL_PORT=int(os.environ.get("MYSQL_PORT", "3306")),
    MYSQL_DATABASE=os.environ.get("MYSQL_DATABASE", "barangay_equipment_db"),
    MYSQL_USER=os.environ.get("MYSQL_USER", "root"),
    MYSQL_PASSWORD=os.environ.get("MYSQL_PASSWORD", ""),
)


@app.errorhandler(Exception)
def handle_unexpected_error(error):
    """Keep implementation details out of ordinary-user error responses."""
    if isinstance(error, HTTPException):
        return error
    app.logger.exception("Unexpected application error")
    if request.path.startswith("/api/"):
        return jsonify(error="Unable to complete the request. Please try again."), 500
    return "Unable to complete the request. No changes were saved. Please try again.", 500


def connection():
    return mysql.connector.connect(
        host=app.config["MYSQL_HOST"], port=app.config["MYSQL_PORT"],
        database=app.config["MYSQL_DATABASE"], user=app.config["MYSQL_USER"],
        password=app.config["MYSQL_PASSWORD"],
    )


def message(page: str, text: str):
    return redirect(url_for(page, message=text))


def is_strong_password(password: str) -> bool:
    return (len(password) >= 12 and any(char.islower() for char in password)
            and any(char.isupper() for char in password) and any(char.isdigit() for char in password)
            and any(not char.isalnum() for char in password))


def dashboard_statistics():
    """Read dashboard totals from the existing MySQL schema.

    Borrowing tables are introduced in a later module, so their statistic is
    queried only when that table exists. This keeps the dashboard usable with
    the current database while avoiding temporary in-memory values.
    """
    db = cursor = None
    stats = {"total_equipment": 0, "available_equipment": 0,
             "active_borrowings": 0, "total_borrowers": 0}
    try:
        db = connection()
        cursor = db.cursor(dictionary=True)
        cursor.execute(
            "SELECT COUNT(*) AS total_equipment, COALESCE(SUM(available_stock), 0) AS available_equipment "
            "FROM equipment"
        )
        stats.update(cursor.fetchone())
        cursor.execute("SHOW TABLES LIKE 'borrowers'")
        borrower_table_exists = cursor.fetchone() is not None
        cursor.execute("SELECT COUNT(*) AS total_borrowers FROM " + ("borrowers" if borrower_table_exists else "users"))
        stats.update(cursor.fetchone())
        cursor.execute("SHOW TABLES LIKE 'borrowings'")
        if cursor.fetchone():
            cursor.execute("SELECT COUNT(*) AS active_borrowings FROM borrowings WHERE status IN ('Active', 'Partially Returned')")
            stats.update(cursor.fetchone())
        return stats, True
    except mysql.connector.Error:
        return stats, False
    finally:
        if cursor:
            cursor.close()
        if db and db.is_connected():
            db.close()


def logged_in():
    return "user_id" in session


def is_admin():
    return str(session.get("role", "")).lower() == "admin"


def admin_required(api=False):
    """Server-side RBAC guard; UI visibility is never the security boundary."""
    if is_admin():
        return None
    if api:
        return jsonify(error="Access denied: only Admin users can perform this action."), 403
    return message("dashboard", "Access denied: only Admin users can perform this action.")


def staff_required(api=False):
    """Guard the borrower-facing interface using the authenticated session role."""
    if logged_in() and not is_admin():
        return None
    if api:
        return jsonify(error="Access denied: only Staff users can perform this action."), 403
    return redirect(url_for("dashboard")) if logged_in() else message("login_page", "Please log in first.")


def equipment_values(form):
    """Validate and normalize an equipment form without trusting client input."""
    name = form.get("equipment_name", "").strip()
    category = form.get("category", "").strip()
    unit_type = form.get("unit_type", "").strip()
    quantity_text = form.get("total_stock", "").strip()
    if not name or not category or not unit_type:
        raise ValueError("Equipment name, category, total quantity, and unit type are required.")
    if len(name) > 100 or len(category) > 100 or len(unit_type) > 50:
        raise ValueError("One or more equipment fields are too long.")
    try:
        total_stock = int(quantity_text)
    except ValueError as error:
        raise ValueError("Total quantity must be a whole number.") from error
    if total_stock <= 0:
        raise ValueError("Total quantity must be greater than zero.")
    return name, category, total_stock, unit_type


def has_active_equipment_loan(cursor, equipment_id):
    """Support the future borrowing module without assuming its tables exist yet."""
    cursor.execute("SHOW TABLES LIKE 'borrowing_items'")
    if not cursor.fetchone():
        return False
    cursor.execute("SHOW TABLES LIKE 'borrowings'")
    if not cursor.fetchone():
        return False
    cursor.execute(
        "SELECT 1 FROM borrowing_items bi JOIN borrowings b ON b.borrowing_id = bi.borrowing_id "
        "WHERE bi.equipment_id = %s AND b.status IN ('Active', 'Partially Returned') LIMIT 1",
        (equipment_id,),
    )
    return cursor.fetchone() is not None


def equipment_status(total_stock, available_stock):
    if available_stock <= 0:
        return "Out of Stock"
    if available_stock < total_stock:
        return "Low Stock"
    return "Available"


def borrower_values(form):
    full_name = form.get("full_name", "").strip()
    contact_number = form.get("contact_number", "").strip()
    address = form.get("address", "").strip()
    email = form.get("email", "").strip().lower()
    if not full_name or not contact_number or not address:
        raise ValueError("Full name, contact number, and address are required.")
    if len(full_name) > 150 or len(contact_number) > 30 or len(address) > 255 or len(email) > 100:
        raise ValueError("One or more borrower fields are too long.")
    if not re.fullmatch(r"[0-9+() .-]{7,30}", contact_number):
        raise ValueError("Enter a valid contact number.")
    if email and not re.fullmatch(r"[^\s@]+@[^\s@]+\.[^\s@]+", email):
        raise ValueError("Enter a valid email address.")
    return full_name, contact_number, address, email or None


def has_active_borrower_loan(cursor, borrower_id):
    cursor.execute("SHOW TABLES LIKE 'borrowings'")
    if not cursor.fetchone():
        return False
    cursor.execute("SELECT 1 FROM borrowings WHERE borrower_id = %s AND status IN ('Active', 'Partially Returned') LIMIT 1", (borrower_id,))
    return cursor.fetchone() is not None


def borrowing_values(form):
    try:
        borrower_id = int(form.get("borrower_id", ""))
    except ValueError as error:
        raise ValueError("Select a valid borrower.") from error
    if borrower_id <= 0:
        raise ValueError("Select a valid borrower.")
    expected_return_date = form.get("expected_return_date", "").strip()
    try:
        due_date = date.fromisoformat(expected_return_date)
    except ValueError as error:
        raise ValueError("Enter a valid expected return date.") from error
    if due_date < date.today():
        raise ValueError("Expected return date cannot be in the past.")
    try:
        raw_items = json.loads(form.get("items", "[]"))
    except (TypeError, json.JSONDecodeError) as error:
        raise ValueError("Transaction items are invalid.") from error
    if not isinstance(raw_items, list) or not raw_items:
        raise ValueError("Add at least one equipment item to the transaction.")
    items, seen = [], set()
    for item in raw_items:
        try:
            equipment_id, quantity = int(item["equipment_id"]), int(item["quantity"])
        except (KeyError, TypeError, ValueError) as error:
            raise ValueError("Each transaction item must have valid equipment and quantity.") from error
        if equipment_id <= 0 or quantity <= 0:
            raise ValueError("Item quantities must be greater than zero.")
        if equipment_id in seen:
            raise ValueError("Duplicate equipment cannot be added to one transaction.")
        seen.add(equipment_id)
        items.append((equipment_id, quantity))
    purpose_notes = form.get("purpose_notes", "").strip()
    if len(purpose_notes) > 2000:
        raise ValueError("Purpose/notes cannot exceed 2,000 characters.")
    return borrower_id, due_date, purpose_notes or None, items


@app.get("/")
@app.get("/login.html")
def login_page():
    return send_from_directory(ROOT, "login.html")


@app.get("/signup.html")
def signup_page():
    return send_from_directory(ROOT, "signup.html")


@app.post("/signup")
def signup():
    full_name = request.form.get("full_name", "").strip()
    username = request.form.get("username", "").strip()
    contact_number = request.form.get("contact_number", "").strip()
    address = request.form.get("address", "").strip()
    email = request.form.get("email", "").strip().lower()
    password = request.form.get("password", "")
    confirm_password = request.form.get("confirm_password", "")

    if not all([full_name, username, contact_number, address, email, password]):
        return message("signup_page", "Complete all fields.")
    if password != confirm_password:
        return message("signup_page", "Passwords do not match.")
    if not is_strong_password(password):
        return message("signup_page", "Use a strong password: 12+ characters with uppercase, lowercase, number, and symbol.")

    db = cursor = None
    try:
        db = connection()
        cursor = db.cursor(dictionary=True)
        cursor.execute("SELECT user_id FROM users WHERE username = %s OR email = %s", (username, email))
        if cursor.fetchone():
            return message("signup_page", "That username or email is already registered.")

        cursor.execute(
            "INSERT INTO users (full_name, username, password, contact_number, address, email, role, status) "
            "VALUES (%s, %s, %s, %s, %s, %s, %s, %s)",
            # Match the existing users table enums. Borrowers currently use a
            # standard Staff account until a separate borrower module exists.
            (full_name, username, generate_password_hash(password), contact_number, address, email, "Staff", "Active"),
        )
        user_id = cursor.lastrowid
        cursor.execute(
            "INSERT INTO borrowers (user_id, full_name, contact_number, address, email) "
            "VALUES (%s, %s, %s, %s, %s)",
            (user_id, full_name, contact_number, address, email),
        )
        cursor.execute(
            "INSERT INTO audit_logs (user_id, action, table_name, record_id, description) VALUES (%s, %s, %s, %s, %s)",
            (user_id, "CREATE", "users", user_id, f"Account created for {username}"),
        )
        db.commit()
        return message("login_page", "Account created. You can now log in.")
    except mysql.connector.Error:
        if db:
            db.rollback()
        return message("signup_page", "Database connection failed. Check XAMPP MySQL and app.py settings.")
    finally:
        if cursor:
            cursor.close()
        if db and db.is_connected():
            db.close()


@app.post("/login")
def login():
    identity = request.form.get("identity", "").strip()
    password = request.form.get("password", "")
    db = cursor = None
    try:
        db = connection()
        cursor = db.cursor(dictionary=True)
        cursor.execute("SELECT user_id, full_name, username, password, role, status FROM users WHERE username = %s OR email = %s", (identity, identity))
        user = cursor.fetchone()
        # MySQL stores the existing enum value as "Active". Compare it
        # case-insensitively so existing records and future registrations work.
        if (not user or str(user["status"]).lower() != "active"
                or not check_password_hash(user["password"], password)):
            return message("login_page", "Invalid username/email or password.")
        session.clear()
        session.update(user_id=user["user_id"], full_name=user["full_name"], username=user["username"], role=user["role"])
        if str(session["role"]).lower() == "admin":
            return redirect(url_for("dashboard"))
        return redirect(url_for("staff_dashboard"))
    except mysql.connector.Error:
        return message("login_page", "Database connection failed. Check XAMPP MySQL and app.py settings.")
    finally:
        if cursor:
            cursor.close()
        if db and db.is_connected():
            db.close()


@app.get("/dashboard")
def dashboard():
    if "user_id" not in session:
        return message("login_page", "Please log in first.")
    if not is_admin():
        return redirect(url_for("staff_dashboard"))
    stats, database_connected = dashboard_statistics()
    return render_template(
        "dashboard.html", stats=stats, database_connected=database_connected,
        full_name=session["full_name"], role=session.get("role", ""),
        show_user_management=session.get("role", "").lower() == "admin",
    )


@app.get("/staff-dashboard")
def staff_dashboard():
    denied = staff_required()
    if denied:
        return denied
    # Requests and borrower-specific loans are introduced in the next workflow
    # step. Keep these account-scoped values at zero rather than exposing
    # system-wide transactions or inferring a users-to-borrowers relationship.
    stats = {"available_equipment": 0, "pending_requests": 0,
             "approved_requests": 0, "currently_borrowed": 0,
             "returned_items": 0}
    database_connected = False
    db = cursor = None
    try:
        db = connection()
        cursor = db.cursor(dictionary=True)
        cursor.execute("SELECT COALESCE(SUM(available_stock), 0) AS available_equipment FROM equipment")
        stats.update(cursor.fetchone())
        cursor.execute("SELECT SUM(b.status='Pending') AS pending_requests, SUM(b.status='Approved') AS approved_requests, SUM(b.status IN ('Active','Partially Returned')) AS currently_borrowed, COALESCE(SUM(CASE WHEN b.status='Returned' THEN bi.quantity_returned ELSE 0 END),0) AS returned_items FROM borrowers br JOIN borrowings b ON b.borrower_id=br.borrower_id LEFT JOIN borrowing_items bi ON bi.borrowing_id=b.borrowing_id WHERE br.user_id=%s", (session["user_id"],))
        stats.update({key: value or 0 for key, value in cursor.fetchone().items()})
        database_connected = True
    except mysql.connector.Error:
        pass
    finally:
        if cursor:
            cursor.close()
        if db and db.is_connected():
            db.close()
    return render_template(
        "staff_dashboard.html", stats=stats, database_connected=database_connected,
        full_name=session["full_name"], role=session.get("role", ""),
    )


