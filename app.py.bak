@app.post("/borrowings/create")
def borrowing_create():
    if not logged_in(): return message("login_page", "Please log in first.")
    denied = admin_required()
    if denied:
        return denied
    try:
        borrower_id, due_date, purpose_notes, items = borrowing_values(request.form)
    except ValueError as error:
        return message("borrowings_page", str(error))
    db = cursor = None
    try:
        db = connection(); db.start_transaction()
        cursor = db.cursor(dictionary=True)
        cursor.execute("SELECT borrower_id FROM borrowers WHERE borrower_id = %s FOR UPDATE", (borrower_id,))
        if not cursor.fetchone():
            raise ValueError("The selected borrower no longer exists.")
        # Lock in a stable order so simultaneous transactions cannot oversell stock.
        locked_equipment = {}
        for equipment_id, quantity in sorted(items):
            cursor.execute("SELECT equipment_name, available_stock FROM equipment WHERE equipment_id = %s FOR UPDATE", (equipment_id,))
            equipment = cursor.fetchone()
            if not equipment:
                raise ValueError("One of the selected equipment records no longer exists.")
            if equipment["available_stock"] < quantity:
                raise ValueError(f"Insufficient stock for {equipment['equipment_name']}. Available: {equipment['available_stock']}.")
            locked_equipment[equipment_id] = equipment
        cursor.execute("INSERT INTO borrowings (borrower_id, processed_by, expected_return_date, purpose_notes, status) VALUES (%s, %s, %s, %s, 'Active')", (borrower_id, session["user_id"], due_date, purpose_notes))
        borrowing_id = cursor.lastrowid
        for equipment_id, quantity in items:
            cursor.execute("INSERT INTO borrowing_items (borrowing_id, equipment_id, quantity_borrowed, quantity_returned) VALUES (%s, %s, %s, 0)", (borrowing_id, equipment_id, quantity))
            cursor.execute("UPDATE equipment SET available_stock = available_stock - %s WHERE equipment_id = %s AND available_stock >= %s", (quantity, equipment_id, quantity))
            if cursor.rowcount != 1:
                raise RuntimeError("Stock changed while saving the transaction. Please try again.")
        cursor.execute("INSERT INTO audit_logs (user_id, action, table_name, record_id, description) VALUES (%s, %s, %s, %s, %s)", (session["user_id"], "CREATE", "borrowings", borrowing_id, f"Created borrowing transaction #{borrowing_id} with {len(items)} item(s)"))
        db.commit()
        return message("borrowings_page", f"Borrowing transaction #{borrowing_id} saved successfully.")
    except (mysql.connector.Error, ValueError, RuntimeError) as error:
        if db: db.rollback()
        return message("borrowings_page", str(error) if isinstance(error, (ValueError, RuntimeError)) else "Unable to save the borrowing transaction. No stock was changed.")
    finally:
        if cursor: cursor.close()
        if db and db.is_connected(): db.close()


